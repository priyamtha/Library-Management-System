<DashboardScreen>:

    MDBoxLayout:
        orientation: "vertical"
        padding: "20dp"
        spacing: "15dp"

        MDLabel:
            text: "📚 Smart Library Dashboard"
            halign: "center"
            font_style: "H4"

        MDRaisedButton:
            text: "Add Book"

        MDRaisedButton:
            text: "View Books"

        MDRaisedButton:
            text: "Search Books"

        MDRaisedButton:
            text: "Issue Book"

        MDRaisedButton:
            text: "Return Book"